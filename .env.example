ODDS_API_KEY=tu_api_key_aqui

# Regiones de bookmakers a consultar en The Odds API (coma-separado).
# Cada region adicional aumenta el consumo de cuota del plan (regions x markets
# por request) - ver docs/superpowers/specs/2026-08-21-multi-region-multi-bookmaker-design.md.
ODDS_API_REGIONS=eu,uk,us

# Bookmakers permitidos para seleccion de mejor precio (coma-separado, ej.
# "pinnacle,bet365,williamhill"). Vacio o ausente = permitir todos los que
# devuelva la API para las regiones configuradas.
ALLOWED_BOOKMAKERS=

# Notificaciones por correo de scripts/daily_workflow.py (src/utils/notifier.py).
# Si alguna falta, el envio se omite (con aviso) sin abortar el resto del workflow.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_SENDER=tu_correo@gmail.com
EMAIL_PASSWORD=tu_password_de_aplicacion
EMAIL_RECEIVER=destinatario@ejemplo.com

# Publicacion de senales en Telegram (src/utils/telegram.py, desde scripts/daily_workflow.py).
# Solo senales sin avisos, siempre con la advertencia de que no son apuestas.
# Si alguna falta, se omite (con aviso). --no-telegram lo desactiva por corrida.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
